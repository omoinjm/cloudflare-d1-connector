# Public URL where D1 Studio is hosted (no trailing slash)
APP_URL=http://localhost:3000

# Cloudflare OAuth client credentials
# Create at: Cloudflare Dashboard → Manage Account → OAuth clients
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=

# OAuth scopes for login (must match GET /oauth/scopes IDs and your OAuth client registration).
# Defaults: account-settings.read user-details.read d1.read d1.write
# CLOUDFLARE_OAUTH_SCOPES=auto

# Used to encrypt Cloudflare refresh tokens at rest (32+ random characters)
SESSION_SECRET=

# Required on Vercel — Workers KV namespace for sessions and saved connections
# Create at: Cloudflare Dashboard → Workers & Pages → KV
# API token needs Workers KV Storage Read + Write on that namespace
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_KV_NAMESPACE_ID=
# CLOUDFLARE_API_TOKEN=
